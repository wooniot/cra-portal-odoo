<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nis2_status_form" model="ir.ui.view">
        <field name="name">nis2.portal.status.form</field>
        <field name="model">nis2.portal.status</field>
        <field name="arch" type="xml">
            <form string="NIS2 readiness" create="false" edit="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh"
                            class="btn-primary" icon="fa-refresh"/>
                    <button name="action_open_verify" type="object" string="Open verify page"
                            class="btn-secondary" icon="fa-shield"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="entity" placeholder="Your organisation"/></h1>
                    </div>
                    <group>
                        <group string="Readiness">
                            <field name="status" widget="badge"
                                   decoration-success="status == 'green'"
                                   decoration-warning="status == 'amber'"
                                   decoration-danger="status == 'red'"/>
                            <field name="label"/>
                            <field name="score"/>
                            <field name="checked_at"/>
                        </group>
                        <group string="Conformity mark">
                            <field name="auth_code"/>
                            <field name="verify_url" widget="url" readonly="1"/>
                            <field name="badge_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        NIS2 (Directive (EU) 2022/2555) readiness, pulled live from CRA-Portal.
                        Configure the connection under Settings &#8594; NIS2-Portal.
                    </p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_nis2_status" model="ir.actions.act_window">
        <field name="name">NIS2 readiness</field>
        <field name="res_model">nis2.portal.status</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_nis2_status_form"/>
    </record>
</odoo>
